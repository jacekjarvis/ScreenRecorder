<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScreenRecorder</AssemblyName>
    <RootNamespace>ScreenRecorder.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms both define Application, Button, etc.; WinForms is only used for the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenRecorder.Core\ScreenRecorder.Core.csproj" />
  </ItemGroup>
</Project>
