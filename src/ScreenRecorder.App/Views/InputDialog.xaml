<Window x:Class="ScreenRecorder.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenRecorder.App.Views"
        Style="{StaticResource DarkWindow}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
        <DockPanel>
            <v:TitleBar x:Name="Bar" DockPanel.Dock="Top" CanMinimize="False"/>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource BandBrush}" Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </Border>
            <StackPanel Margin="18,14,18,16">
                <TextBlock x:Name="Prompt" Margin="0,0,0,6"/>
                <TextBox x:Name="Answer" Height="28"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
