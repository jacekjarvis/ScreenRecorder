<Window x:Class="ScreenRecorder.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenRecorder.App.Views"
        Title="Export to MP4" Style="{StaticResource DarkWindow}" Width="560" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
        <StackPanel>
            <v:TitleBar x:Name="Bar" Title="Export to MP4"/>
            <StackPanel x:Name="OptionsPanel" Margin="20,12,20,8">
                <TextBlock x:Name="RangeText" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <TextBlock Text="Save as" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="OutputPath" Height="28"/>
                </DockPanel>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Video quality" VerticalAlignment="Center"/>
                    <ComboBox x:Name="VideoQualityCombo" Grid.Column="1" Width="280" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Text="Sound quality" VerticalAlignment="Center"/>
                    <ComboBox x:Name="AudioQualityCombo" Grid.Row="1" Grid.Column="1" Width="280" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock Text="Include" Margin="0,8,0,8"/>
                <WrapPanel Margin="0,0,0,10">
                    <CheckBox x:Name="IncCursor" Content="Mouse cursor" Margin="0,0,22,8"/>
                    <CheckBox x:Name="IncPc" Content="PC sounds" Margin="0,0,22,8"/>
                    <CheckBox x:Name="IncMic" Content="Microphone" Margin="0,0,22,8"/>
                    <CheckBox x:Name="IncCam" Content="Webcam (picture-in-picture)" Margin="0,0,22,8"/>
                </WrapPanel>
                <CheckBox x:Name="UseHardware" Content="Use the graphics card to encode (much faster)" Margin="0,0,0,4"/>
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Margin="20,4,20,10" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Maximum="1" Height="10" Margin="0,0,0,8"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource Subtle}"/>
            </StackPanel>

            <Border Background="{StaticResource BandBrush}" Padding="12,10" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenFileButton" Content="Play the MP4" Visibility="Collapsed" Click="OpenFile_Click"/>
                    <Button x:Name="ShowFolderButton" Content="Show in folder" Margin="8,0,0,0" Visibility="Collapsed" Click="ShowFolder_Click"/>
                    <Button x:Name="ExportButton" Content="Export" IsDefault="True" Margin="8,0,0,0" Click="Export_Click"/>
                    <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
