<Window x:Class="ScreenRecorder.App.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Width="320" Height="170" Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
        <DockPanel Margin="10">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Save" MinWidth="60" Padding="10,2" IsDefault="True" Click="Save_Click"/>
                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                <TextBlock x:Name="Header" Style="{StaticResource Label}"/>
            </DockPanel>
            <TextBox x:Name="NoteText" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Border>
</Window>
