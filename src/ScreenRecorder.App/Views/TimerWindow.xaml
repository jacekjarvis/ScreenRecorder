<Window x:Class="ScreenRecorder.App.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenRecorder.App.Views"
        Title="Set Timer" Style="{StaticResource DarkWindow}" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
        <StackPanel>
            <v:TitleBar Title="Set Timer" CanMinimize="False"/>
            <StackPanel Margin="20,12,20,12">
                <CheckBox x:Name="UseScheduling" Content="Use scheduling" FontWeight="SemiBold" Click="Changed"/>
                <Grid x:Name="Fields" Margin="24,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Start at" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="StartDate" Width="110" Height="26"/>
                        <TextBox x:Name="StartTime" Width="70" Margin="8,0,0,0" Height="26" ToolTip="24-hour time, e.g. 14:30"/>
                    </StackPanel>
                    <RadioButton x:Name="ByDuration" Grid.Row="1" Content="Stop after" VerticalAlignment="Center" GroupName="stop" Click="Changed"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="Duration" Width="70" Height="26"/>
                        <TextBlock Text="minutes" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <RadioButton x:Name="ByTime" Grid.Row="2" Content="Stop at" VerticalAlignment="Center" GroupName="stop" Click="Changed"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="StopDate" Width="110" Height="26"/>
                        <TextBox x:Name="StopTime" Width="70" Margin="8,0,0,0" Height="26"/>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                           Text="After setting the timer, click Record as normal. Recording starts at the set time, and scheduling switches off once it has run."/>
                <TextBlock x:Name="Error" Foreground="#FFFF6B6B" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <Border Background="{StaticResource BandBrush}" Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
