<Window x:Class="ScreenRecorder.App.Views.RecordingControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenRecorder.App.Views"
        Title="Recording" Style="{StaticResource DarkWindow}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
        <StackPanel>
            <v:TitleBar x:Name="Bar" Title="Recording" CanMinimize="False"/>
            <StackPanel Orientation="Horizontal" Margin="18,10,18,6" HorizontalAlignment="Center">
                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource RecordBrush}" Margin="0,0,10,0"/>
                <TextBlock x:Name="TimeText" FontFamily="Consolas" FontSize="26"/>
            </StackPanel>
            <TextBlock x:Name="StateText" Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="14,0,14,16">
                <Button Width="96" Click="Stop_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal"><Rectangle Width="10" Height="10" Fill="White" Margin="0,0,8,0"/><TextBlock Text="Stop"/></StackPanel>
                </Button>
                <Button x:Name="PauseButton" Width="96" Margin="8,0,0,0" Click="Pause_Click">
                    <TextBlock x:Name="PauseText" Text="Pause"/>
                </Button>
                <Button Width="96" Margin="8,0,0,0" Click="Restart_Click" ToolTip="Discard what has been recorded and start again">
                    <TextBlock Text="Restart"/>
                </Button>
                <Button Width="96" Margin="8,0,0,0" Click="Marker_Click">
                    <TextBlock Text="Add marker"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
