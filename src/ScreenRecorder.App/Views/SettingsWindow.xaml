<Window x:Class="ScreenRecorder.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScreenRecorder.App.Views"
        Title="Settings" Style="{StaticResource DarkWindow}" Width="660" Height="470"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Row" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Heading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
        <DockPanel>
            <v:TitleBar DockPanel.Dock="Top" Title="Settings" CanMinimize="False"/>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource BandBrush}" Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </Border>
            <TabControl x:Name="Tabs">
                <TabItem Header="Window">
                    <StackPanel>
                        <TextBlock Text="When minimized" Style="{StaticResource Heading}"/>
                        <RadioButton x:Name="MinTray" Content="Minimize to the icon tray" Style="{StaticResource {x:Type RadioButton}}" Margin="0,0,0,10"/>
                        <RadioButton x:Name="MinFloating" Content="Minimize to floating controls" Margin="0,0,0,18"/>
                        <CheckBox x:Name="MinWhileRecording" Content="Minimize the Recorder while recording"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Video">
                    <StackPanel>
                        <TextBlock Text="Video" Style="{StaticResource Heading}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Frames per second" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FpsCombo" Width="90"/>
                        </StackPanel>
                        <TextBlock x:Name="EncoderText" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Recordings are stored at high quality and the mouse cursor is kept separately, so it can be shown or hidden when you export."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Sound">
                    <StackPanel>
                        <TextBlock Text="Sound sources" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Microphone" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MicCombo" Width="360" HorizontalAlignment="Left" Margin="0,0,0,14" DisplayMemberPath="Name"/>
                        <TextBlock Text="PC sounds (speakers / headphones)" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PcCombo" Width="360" HorizontalAlignment="Left" Margin="0,0,0,14" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="Each source is recorded on its own track. Turn them on or off on the main window."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Webcam">
                    <StackPanel>
                        <TextBlock Text="Webcam" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Device" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CamCombo" Width="360" HorizontalAlignment="Left" Margin="0,0,0,14" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="The webcam isn't shown while recording. It appears as picture-in-picture (bottom right) when you export."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Display">
                    <StackPanel>
                        <TextBlock Text="Cleaner recordings" Style="{StaticResource Heading}"/>
                        <CheckBox x:Name="HideIcons" Content="Hide desktop icons while recording"/>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="Jarvo Screen Recorder's own windows (toolbar, frame, notes) are never shown in recordings."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Keystrokes">
                    <StackPanel>
                        <TextBlock Text="Keystrokes" Style="{StaticResource Heading}"/>
                        <CheckBox x:Name="CaptureKeys" Content="Capture keystrokes" Margin="0,0,0,12"/>
                        <CheckBox x:Name="MaskPasswords" Content="Replace password characters with *" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="Keystrokes are saved with the recording so they can be displayed later. Password characters typed into web pages or Remote Desktop can't be detected."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Hotkeys">
                    <StackPanel>
                        <TextBlock Text="Hotkeys" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Subtle}" Text="Click a box and press the key combination." Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Start / stop recording" VerticalAlignment="Center"/>
                            <TextBox x:Name="HkStartStop" Grid.Column="1" Height="26" PreviewKeyDown="Hotkey_KeyDown" IsReadOnly="True"/>
                            <TextBlock Grid.Row="1" Text="Pause / resume" VerticalAlignment="Center"/>
                            <TextBox x:Name="HkPause" Grid.Row="1" Grid.Column="1" Height="26" PreviewKeyDown="Hotkey_KeyDown" IsReadOnly="True"/>
                            <TextBlock Grid.Row="2" Text="Show recording controls" VerticalAlignment="Center"/>
                            <TextBox x:Name="HkControls" Grid.Row="2" Grid.Column="1" Height="26" PreviewKeyDown="Hotkey_KeyDown" IsReadOnly="True"/>
                            <TextBlock Grid.Row="3" Text="Add marker" VerticalAlignment="Center"/>
                            <TextBox x:Name="HkMarker" Grid.Row="3" Grid.Column="1" Height="26" PreviewKeyDown="Hotkey_KeyDown" IsReadOnly="True"/>
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="File Size">
                    <StackPanel>
                        <TextBlock Text="Limit the recording size" Style="{StaticResource Heading}"/>
                        <RadioButton x:Name="SizeUnlimited" Content="Unlimited" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="SizeLimited" Content="Stop recording when it reaches" VerticalAlignment="Center"/>
                            <TextBox x:Name="SizeMb" Width="80" Height="26" Margin="10,0,6,0"/>
                            <TextBlock Text="MB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="Recording also stops automatically if less than 2 GB of disk space is left."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Record-time Notes">
                    <StackPanel>
                        <TextBlock Text="Record-time notes" Style="{StaticResource Heading}"/>
                        <CheckBox x:Name="NotesEnabled" Content="Enable notes" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Show the note window when the mouse is moved to the" VerticalAlignment="Center"/>
                            <ComboBox x:Name="NotesEdge" Width="90" Margin="8,0,6,0"/>
                            <TextBlock Text="edge" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="NotesPause" Content="Pause recording while the note window is open" Margin="0,0,0,12"/>
                        <CheckBox x:Name="NotesAutoSave" Content="Save the note when the mouse leaves the window"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Files">
                    <StackPanel>
                        <TextBlock Text="Where recordings are saved" Style="{StaticResource Heading}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                            <TextBox x:Name="OutputFolder" Height="28"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="An hour of full-HD recording usually takes 1–4 GB, depending on how much changes on screen."/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
